generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PHARMACY_OWNER
  PHARMACY_STAFF
}

enum StockStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PROFESSIONAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(PHARMACY_STAFF)

  pharmacyId Int?
  pharmacy   Pharmacy? @relation(fields: [pharmacyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pharmacy {
  id      Int     @id @default(autoincrement())
  name    String
  address String
  phone   String?
  email   String?

  latitude  Float?
  longitude Float?

  openingHours String?

  users        User[]
  inventory    Inventory[]
  sales        Sale[]
  searches     MedicineSearch[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medicine {
  id          Int     @id @default(autoincrement())
  name        String
  genericName String?
  category    String?

  inventory Inventory[]
  saleItems SaleItem[]
  searches  MedicineSearch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([genericName])
}

model Inventory {
  id Int @id @default(autoincrement())

  pharmacyId Int
  medicineId Int

  quantity Int   @default(0)
  price    Float

  stockStatus StockStatus @default(AVAILABLE)

  section String?
  shelf   String?
  row     String?

  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, medicineId])
}

model Sale {
  id Int @id @default(autoincrement())

  pharmacyId  Int
  totalAmount Float

  createdAt DateTime @default(now())

  pharmacy Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  items    SaleItem[]

  @@index([pharmacyId])
  @@index([createdAt])
}

model SaleItem {
  id Int @id @default(autoincrement())

  saleId     Int
  medicineId Int

  quantity   Int
  unitPrice  Float
  totalPrice Float

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
}

model MedicineSearch {
  id Int @id @default(autoincrement())

  pharmacyId Int
  medicineId Int

  createdAt DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@index([pharmacyId])
  @@index([createdAt])
}

model Subscription {
  id Int @id @default(autoincrement())

  pharmacyId Int @unique

  plan   SubscriptionPlan
  status SubscriptionStatus @default(PENDING)

  startDate   DateTime?
  renewalDate DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
