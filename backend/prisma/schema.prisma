generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(PHARMACY_STAFF)
  pharmacyId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([email])
  @@index([pharmacyId])
}

model Pharmacy {
  id                   Int                @id @default(autoincrement())
  name                 String
  address              String
  phone                String?
  email                String?
  latitude             Float?
  longitude            Float?
  openingHours         String?
  tinNumber            String?            @unique
  businessRegistration String?
  businessLicense      String?
  pharmacyLicense      String?
  pharmacyPhoto        String?
  ownerIdNumber        String?
  ownerIdDocument      String?
  verificationStatus   VerificationStatus @default(PENDING)
  verificationReason   String?
  verifiedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  inventory    Inventory[]
  payments     Payment[]
  subscription Subscription?
  users        User[]
  feedbacks    Feedback[]
}

model Medicine {
  id          Int      @id @default(autoincrement())
  name        String
  genericName String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory Inventory[]
  searches  MedicineSearch[]

  @@index([name])
  @@index([genericName])
}

model Inventory {
  id          Int         @id @default(autoincrement())
  pharmacyId  Int
  medicineId  Int
  quantity    Int         @default(0)
  price       Float
  stockStatus StockStatus @default(AVAILABLE)
  section     String?
  shelf       String?
  row         String?
  updatedAt   DateTime    @updatedAt

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, medicineId])
}

model MedicineSearch {
  id         Int      @id @default(autoincrement())
  query      String
  medicineId Int?
  createdAt  DateTime @default(now())

  medicine Medicine? @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([query])
  @@index([medicineId])
}

model Subscription {
  id          Int                @id @default(autoincrement())
  pharmacyId  Int                @unique
  plan        SubscriptionPlan
  status      SubscriptionStatus @default(PENDING)
  startDate   DateTime?
  renewalDate DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
}

model Payment {
  id                 Int              @id @default(autoincrement())
  pharmacyId         Int
  plan               SubscriptionPlan
  amount             Float
  transactionId      String           @unique
  status             PaymentStatus    @default(PENDING)
  screenshotName     String?
  screenshotMimeType String?
  screenshotSize     Int?
  verifiedAt         DateTime?
  rejectedAt         DateTime?

  bankAccountId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([bankAccountId])
}

model BankAccount {
  id            Int     @id @default(autoincrement())
  bankName      String
  accountName   String
  accountNumber String
  branch        String?
  instructions  String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([isActive])
}

model TransportationRate {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  ratePerKm Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id         Int                @id @default(autoincrement())
  senderType FeedbackSenderType
  name       String?
  email      String?
  pharmacyId Int?
  category   String
  message    String
  status     FeedbackStatus     @default(NEW)
  adminReply String?
  repliedAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@index([senderType])
  @@index([status])
  @@index([createdAt])
  @@index([pharmacyId])
}

enum UserRole {
  ADMIN
  PHARMACY_OWNER
  PHARMACY_STAFF
}

enum StockStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
}

enum SubscriptionPlan {
  BASIC
  ONE_WEEK
  ONE_MONTH
  STANDARD
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransportationType {
  WALKING
  MOTORCYCLE
  BUS
  TAXI
  PRIVATE_CAR
}

enum FeedbackSenderType {
  PATIENT
  PHARMACY
}

enum FeedbackStatus {
  NEW
  REVIEWING
  RESPONDED
  RESOLVED
}
